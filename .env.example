# OPEN_GROCERY_TRANSPORT=stdio
# OPEN_GROCERY_HOST=127.0.0.1
# OPEN_GROCERY_PORT=8000

# Authenticated retailer writes are disabled unless explicitly enabled.
# OPEN_GROCERY_ENABLE_RETAILER_WRITES=0

# Final order submission has independent opt-ins and a local approval code.
# OPEN_GROCERY_ENABLE_ORDER_SUBMISSION=0
# OPEN_GROCERY_ENABLE_BROWSER_ORDER_SUBMISSION=0
# OPEN_GROCERY_ORDER_APPROVAL_CODE=change-this-to-at-least-6-characters

# Browser workflows (Gadis/Froiz and interactive login).
# OPEN_GROCERY_STATE_DIR=~/.open-grocery-mcp
# OPEN_GROCERY_BROWSER_HEADLESS=1
# OPEN_GROCERY_BROWSER_SUBMIT_HEADLESS=0
# OPEN_GROCERY_BROWSER_CHANNEL=chrome
# OPEN_GROCERY_BROWSER_EXECUTABLE=/path/to/chromium
# OPEN_GROCERY_GADIS_BROWSER_CHANNEL=chrome
# OPEN_GROCERY_GADIS_BROWSER_EXECUTABLE=
# OPEN_GROCERY_FROIZ_BROWSER_CHANNEL=chrome
# OPEN_GROCERY_FROIZ_BROWSER_EXECUTABLE=

# Mercadona browser session and catalogue configuration.
# OPEN_GROCERY_MERCADONA_STATE_PATH=~/.open-grocery-mcp/mercadona/storage_state.json
# OPEN_GROCERY_MERCADONA_BROWSER_CHANNEL=chrome
# OPEN_GROCERY_MERCADONA_WAREHOUSE=mad1
# OPEN_GROCERY_MERCADONA_ALGOLIA_APP=
# OPEN_GROCERY_MERCADONA_ALGOLIA_KEY=

# Pin a Gadis catalogue assortment when you know the store identifier.
# OPEN_GROCERY_GADIS_STORE=

# Public Froiz search instance.
# OPEN_GROCERY_FROIZ_INSTANCE=froiz
